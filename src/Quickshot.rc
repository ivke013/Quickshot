#if !defined(AFX_RESOURCE_DLL) || defined(AFX_TARG_ENU)
LANGUAGE 9, 1

/////////////////////////////////////////////////////////////////////////////
// Icon
IDI_APP                 ICON         "..\\assets\\icons\\Screenshot_App.ico"
IDI_TRAY                ICON         "..\\assets\\icons\\Screenshot_Tray.ico"
IDI_QUICKSHOT           ICON         "..\\assets\\icons\\Screenshot_App.ico"
IDI_SMALL               ICON         "..\\assets\\icons\\Screenshot_Tray.ico"

