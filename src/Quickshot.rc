IDR_PNG64_HIGHLIGHT     RCDATA      "..\\assets\\toolbar\\64\\icon_highlight.png"
IDR_PNG64_LINE          RCDATA      "..\\assets\\toolbar\\64\\icon_line.png"
IDR_PNG64_ARROW         RCDATA      "..\\assets\\toolbar\\64\\icon_arrow.png"
IDR_PNG64_RECT          RCDATA      "..\\assets\\toolbar\\64\\icon_rect.png"
